---
import Layout from '../layouts/Layout.astro';
import "@emailjs/browser";
---
<Layout>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""/>
    
    <style>
        #leaflet-map {
            width: 100%;
            min-height: 300px;   
            height: 480px;       
            display: block;
        }

        @media (max-width: 992px) {
            #leaflet-map {
                height: 400px;
            }
        }

        @media (max-width: 768px) {
            #leaflet-map {
                height: 350px;
            }
            .map-section {
                padding: 0 10px;
            }
        }

        @media (max-width: 576px) {
            #leaflet-map {
                height: 320px;
            }
        }

        @media (max-width: 400px) {
            #leaflet-map {
                height: 300px;
            }
        }

        .directions-button {
            display: inline-block;
            margin-top: 10px;
            padding: 8px 15px;
            background-color: #007bff;
            color: white !important;
            text-decoration: none;
            border-radius: 5px;
            text-align: center;
        }

        .contact_address {
            padding: 40px 0;
        }

        .contact_address_inner {
            margin-bottom: 30px;
        }

        .contact_social_media ul {
            list-style: none;
            padding: 0;
            display: flex;
            gap: 10px;
        }

        .contact_social_media ul li a {
            font-size: 18px;
            color: #333;
            transition: color 0.3s ease;
        }

        .contact_social_media ul li a:hover {
            color: #007bff;
        }

        @media (max-width: 991px) {
            .contact_address .row {
                display: flex;
                flex-direction: column;
            }
            .contact_address .col-lg-4,
            .contact_address .col-lg-8 {
                width: 100%;
                max-width: 100%;
            }
            .contact_address_inner {
                order: 2; 
            }
            .contact_pg_form {
                order: 3; 
                margin-top: 20px;
            }
        }
    </style>

    <!-- Map Section -->
    <section class="map-section">
        <div class="map-outer">
            <div id="leaflet-map"></div>
        </div>
    </section>
    
    <!-- Contact Info & Form -->
    <div class="contact_address">
        <div class="container">
            <div class="row">
                
                <!-- Contact Details -->
                <div class="col-lg-4 col-md-12">
                    <div class="contact_address_inner">
                        <div class="contact_our_office">
                            <h2><span>Address</span></h2>
                            <p>2nd Floor, Advani Chambers, 574, August Kranti Rd, Kemps Corner, 
Malabar Hill, Mumbai, Maharashtra 400026</p>
                        </div>
                        <div class="contact_get_in_touch">
                            <h2>Get in <span>Touch</span></h2>
                            <div class="mail">
                                <p>EMAIL<br/>
                                <a href="mailto:naivaidyahealthcare@gmail.com">naivaidyahealthcare@gmail.com</a></p>
                            </div>
                            <div class="phone">
                                <p>Phone number<br/>
                                    <a href="tel:8591420775" class="phne">(+91) 8591420775</a></p>
                            </div>
                        </div>
                        <div class="contact_social_media">
                            <ul>
                                <li><a href="#"><i class="fa fa-linkedin"></i></a></li>
                                <li><a href="#"><i class="fa fa-instagram"></i></a></li>
                                <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Contact Form -->
<div class="col-lg-8 col-md-12">
  <div class="contact_pg_form">
    <form id="contact-form">
      <div class="messages"></div>
      <div class="controls">
        <div class="row">
          <div class="col-md-6">
            <div class="form-group">
              <input id="form_name" type="text" name="name" placeholder="Name *" required data-error="Name is required.">
              <div class="help-block with-errors"></div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-group">
              <input id="form_email" type="email" name="email" placeholder="Email *" required data-error="Valid email is required.">
              <div class="help-block with-errors"></div>
            </div>
          </div>
          <div class="col-md-12">
            <div class="form-group">
              <input id="form_phone" type="text" name="phone" placeholder="Phone *" required data-error="Phone is required.">
              <div class="help-block with-errors"></div>
            </div>
          </div>
          <div class="col-md-12">
            <div class="form-group">
              <textarea id="form_message" name="message" placeholder="Message" rows="6" required data-error="Please, leave us a message."></textarea>
              <div class="help-block with-errors"></div>
            </div>
          </div>
          <div class="col-md-12">
            <input type="submit" class="theme-btn btn-send" value="Send message">
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<script type="module">
  import emailjs from "@emailjs/browser";

  const form = document.getElementById("contact-form");

  form.addEventListener("submit", function (e) {
    e.preventDefault();

    emailjs.sendForm(
      "service_gwmvxe8",   
      "template_lrqh0th",  
      "#contact-form",     
      "b8e_uW9KrxruGWal1"   
    ).then(
      () => {
        alert("Message sent successfully!");
        form.reset();
      },
      (error) => {
        console.error("EmailJS Error:", error);
        alert("Failed to send message. Please try again later.");
      }
    );
  });
</script>

    <!-- Leaflet Script -->
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""></script>

    <script is:inline>
        const lat = 18.9636;
        const lng = 72.8066;
        const zoom = 16;
        const map = L.map('leaflet-map').setView([lat, lng], zoom);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        const redIcon = new L.Icon({
            iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
            shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
            iconSize: [25, 41],
            iconAnchor: [12, 41],
            popupAnchor: [1, -34],
            shadowSize: [41, 41]
        });

        const marker = L.marker([lat, lng], { icon: redIcon }).addTo(map);

        const popupContent = `
            <h4>Naivaidya Clinic</h4>
            <p>2nd Floor, Advani Chambers, Kemps Corner, Malabar Hill, Mumbai</p>
            <a href="https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}" class="directions-button" target="_blank">
                Get Directions
            </a>
        `;

        marker.bindPopup(popupContent);

        setTimeout(() => {
            map.invalidateSize();
        }, 500);

        window.addEventListener("resize", () => {
            map.invalidateSize();
        });
    </script>

</Layout>
