---
import Layout from "../layouts/Layout.astro";
import Slider from "../components/Slider.astro";
import "../styles/index.css";
---

<Layout>
  <Slider />

  <section class="appointment_section hm-one">
    <div class="container">
      <div class="appointment_inner">
        <div class="row">
          <div class="col-lg-2 col-md-6 col-sm-12">
            <div class="appont_sec_inner">
              <h6>EMERGENCY</h6>
              <a href="tel:8591420775" style="font-size: 18px;"
                >+91 8591420775</a
              >
              <p>
                Urgent cases are our top priority and are attended immediately.
              </p>
            </div>
          </div>
          <div class="col-lg-4 col-md-6 col-sm-12">
            <div class="appont_sec_inner">
              <h6>WORK HOURS</h6>
              <div class="row">
                <div class="col-12 col-sm-6">
                  <strong style="font-size: 18px;">Dr. Saurabh Jain</strong>
                  <ul class="work-hours-list">
                    <li>Mon - <span>3:00 PM - 6:30 PM</span></li>
                    <li>Tue - <span>3:00 PM - 6:30 PM</span></li>
                    <li>Wed - <span>3:00 PM - 6:30 PM</span></li>
                    <li>Thu - <span>11:00 AM - 1:00 PM</span></li>
                    <li>Fri - <span>3:00 PM - 6:30 PM</span></li>
                  </ul>
                </div>
                <div class="col-12 col-sm-6">
                  <strong style="font-size: 18px;">Dr. Zimpu Jain</strong>
                  <ul class="work-hours-list">
                    <li>Mon - <span>12:00 PM - 4:00 PM</span></li>
                    <li>Tue - <span>12:00 PM - 4:00 PM</span></li>
                    <li>Wed - <span>12:00 PM - 4:00 PM</span></li>
                    <li>Thu - <span>10:00 AM - 1:00 PM</span></li>
                    <li>Fri - <span>12:00 PM - 4:00 PM</span></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
          <div class="d-lg-block col-lg-half d-none"></div>
          <div class="col-lg-5 col-md-12 col-sm-12">
            <div class="appont_sec_inner">
              <h6>BOOK YOUR WELLNESS SLOT</h6>
              <form method="post" action="#">
  <div class="clearfix row">
    <div class="col-12">
      <div class="form-group">
        <input
          type="text"
          name="name"
          placeholder="Name*"
          required=""
        />
      </div>
    </div>
    <div class="col-12">
      <div class="form-group">
        <input
          type="email"
          name="phone"
          placeholder="Phone*"
          required=""
        />
      </div>
    </div>
    <div class="col-12">
      <div class="form-group">
        <input
          type="text"
          name="Current Problem"
          placeholder="Current Problem*"
          required=""
        />
      </div>
    </div>
    <div class="col-12">
      <div class="form-group">
        <input
          type="text"
          name="Past History"
          placeholder="Past History*"
          required=""
        />
      </div>
    </div>
    <div class="form-group col-12">
      <button class="theme-btn" type="submit" name="submit-form">
        BOOK YOUR APPOINTMENT NOW
      </button>
    </div>
  </div>
</form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="department_section hm-one">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="clearfix heading">
            <h1>AREAS <span>OF CARE</span></h1>
          </div>
        </div>
      </div>
      <div class="department_inner">
        <div class="row">
          <div class="col-lg-12">
            <div class="department_icon_content">
              <span class="flaticon-doctor-1 dep_icon"></span>
              <h2>Consultation</h2>
              <p>
                A one-on-one session with our experienced medical professionals
                to understand your health concerns, guide diagnosis, and plan
                personalized treatment.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-lab dep_icon"></span>
              <h2>Pathology</h2>
              <p>
                Essential laboratory testing of blood, urine, and tissues that
                helps detect, monitor, and prevent a wide range of medical
                conditions.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-bones dep_icon"></span>
              <h2>Digital X- ray</h2>
              <p>
                Advanced imaging that provides fast, detailed internal views to
                help diagnose injuries, infections, and other health issues with
                accuracy.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-heart-2 dep_icon"></span>
              <h2>ECG</h2>
              <p>
                A safe, quick test that records the heart's electrical activity
                to detect abnormalities in rhythm, rate, or structure.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-heart dep_icon"></span>
              <h2>2D Echocardiography</h2>
              <p>
                An ultrasound-based scan that gives real-time visuals of the
                heart's chambers, valves, and movement to evaluate cardiac
                health.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-heart-1 dep_icon"></span>
              <h2>Treadmill / Stress Test</h2>
              <p>
                A heart performance test conducted during physical activity to
                assess how well your heart functions under stress.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-stomach dep_icon"></span>
              <h2>Sonography & Doppler</h2>
              <p>
                Ultrasound imaging used to observe internal organs, monitor
                pregnancies, and assess blood flow without the use of radiation.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-lung dep_icon"></span>
              <h2 style="font-size: 18px;">Pulmonary Function Test (PFT)</h2>
              <p>
                Breathing assessments that measure lung capacity and airflow to
                help diagnose and manage respiratory conditions like asthma or
                COPD.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-time dep_icon"></span>
              <h2>Day Care Services</h2>
              <p>
                Medical treatments and minor procedures performed within the
                day, eliminating the need for overnight hospitalization.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-drug dep_icon"></span>
              <h2>IV Infusion Therapy</h2>
              <p>
                Direct administration of fluids or medications into the
                bloodstream for quicker recovery and improved treatment
                effectiveness.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-test dep_icon"></span>
              <h2>Vaccinations</h2>
              <p>
                Protective immunizations that guard against harmful diseases and
                strengthen long-term immunity for all age groups.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-automation dep_icon"></span>
              <h2>Drugless Therapies</h2>
              <p>
                Natural, non-pharmaceutical healing methods such as yoga,
                physiotherapy, and lifestyle modifications to support holistic
                well-being.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-physiotherapy dep_icon"></span>
              <h2>Physiotherapy</h2>
              <p>
                Therapeutic movement and exercise techniques that aid in
                recovery, reduce pain, and improve strength and mobility.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-stomach dep_icon"></span>
              <h2>Diet & Nutrition</h2>
              <p>
                Customized diet planning that supports overall health, disease
                management, and recovery through balanced and mindful eating.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="best-doctors hme-one">
