---
import Layout from "../layouts/Layout.astro";
import Slider from "../components/Slider.astro";
import "../styles/index.css";
---

<Layout>
  <Slider />

  <section class="appointment_section hm-one">
    <div class="container">
      <div class="appointment_inner">
        <div class="row">
          <div class="col-lg-2 col-md-6 col-sm-12">
            <div class="appont_sec_inner">
              <h6>GET IN TOUCH</h6>
              <a href="tel:8591420775" style="font-size: 18px;"
                >+91 8591420775</a
              >
              <p>Contact us for any questions or assistance.</p>

              <div style="margin-top: 1rem;">
                <h6>Pathology Timings</h6>
                <ul class="work-hours-list">
                  <li><span>9:00 AM - 8:00 PM</span></li>
                </ul>
                <p style="text-transform: none;">
                  Home visit facility available with prior booking.
                </p>
              </div>
            </div>
          </div>
          <div class="col-lg-6 col-md-6 col-sm-12">
            <div class="appont_sec_inner">
              <h6>WORK HOURS</h6>
              <div class="row">
                <div class="col">
                  <strong style="font-size: 18px;">Dr. Saurabh Jain</strong>
                  <ul class="work-hours-list">
                    <li>Mon - <span>3:00 PM - 6:30 PM</span></li>
                    <li>Tue - <span>3:00 PM - 6:30 PM</span></li>
                    <li>Wed - <span>3:00 PM - 6:30 PM</span></li>
                    <li>Thu - <span>11:00 AM - 1:00 PM</span></li>
                    <li>Fri - <span>3:00 PM - 6:30 PM</span></li>
                  </ul>
                </div>
                <div class="col">
                  <strong style="font-size: 18px;">Dr. Zimpu Jain</strong>
                  <ul class="work-hours-list">
                    <li>Mon - <span>12:00 PM - 4:00 PM</span></li>
                    <li>Tue - <span>12:00 PM - 4:00 PM</span></li>
                    <li>Wed - <span>12:00 PM - 4:00 PM</span></li>
                    <li>Thu - <span>10:00 AM - 1:00 PM</span></li>
                    <li>Fri - <span>12:00 PM - 4:00 PM</span></li>
                  </ul>
                </div>
                <div class="col">
                  <strong style="font-size: 18px;">Available Consultants</strong
                  >
                  <ul class="work-hours-list">
                    <li>
                      Dr. Jignesh Mepani <br /><span>On Appointment</span>
                    </li>
                    <li>
                      Dr. Pulkit Popat <br /><span>On Appointment</span>
                    </li>
                    <li>
                      Ms. Harshita Saraogi <br /><span>On Appointment</span>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-4 col-md-12 col-sm-12">
            <div class="appont_sec_inner">
              <h6>BOOK YOUR WELLNESS SLOT</h6>
              <form method="post" action="#">
                <div class="clearfix row">
                  <div class="col-12">
                    <div class="form-group">
                      <input
                        type="text"
                        name="name"
                        placeholder="Name*"
                        required=""
                      />
                    </div>
                  </div>
                  <div class="col-12">
                    <div class="form-group">
                      <input
                        type="email"
                        name="phone"
                        placeholder="Phone*"
                        required=""
                      />
                    </div>
                  </div>
                  <div class="col-12">
                    <div class="form-group">
                      <input
                        type="text"
                        name="Current Problem"
                        placeholder="Current Problem*"
                        required=""
                      />
                    </div>
                  </div>
                  <div class="col-12">
                    <div class="form-group">
                      <input
                        type="text"
                        name="Past History"
                        placeholder="Past History*"
                        required=""
                      />
                    </div>
                  </div>
                  <div class="form-group col-12">
                    <button class="theme-btn" type="submit" name="submit-form">
                      BOOK YOUR APPOINTMENT NOW
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="department_section hm-one">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="clearfix heading">
            <h1>AREAS <span>OF CARE</span></h1>
          </div>
        </div>
      </div>
      <div class="department_inner">
        <div class="row">
          <div class="col-lg-12">
            <div class="department_icon_content">
              <span class="flaticon-doctor-1 dep_icon"></span>
              <h2>Consultation</h2>
              <p>
                A one-on-one session with our experienced medical professionals
                to understand your health concerns, guide diagnosis, and plan
                personalized treatment.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-lab dep_icon"></span>
              <h2>Pathology</h2>
              <p>
                Essential laboratory testing of blood, urine, and tissues that
                helps detect, monitor, and prevent a wide range of medical
                conditions.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-bones dep_icon"></span>
              <h2>Digital X- ray</h2>
              <p>
                Advanced imaging that provides fast, detailed internal views to
                help diagnose injuries, infections, and other health issues with
                accuracy.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-heart-2 dep_icon"></span>
              <h2>ECG</h2>
              <p>
                A safe, quick test that records the heart's electrical activity
                to detect abnormalities in rhythm, rate, or structure.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-heart dep_icon"></span>
              <h2>2D Echocardiography</h2>
              <p>
                An ultrasound-based scan that gives real-time visuals of the
                heart's chambers, valves, and movement to evaluate cardiac
                health.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-heart-1 dep_icon"></span>
              <h2>Treadmill / Stress Test</h2>
              <p>
                A heart performance test conducted during physical activity to
                assess how well your heart functions under stress.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-stomach dep_icon"></span>
              <h2>Sonography & Doppler</h2>
              <p>
                Ultrasound imaging used to observe internal organs, monitor
                pregnancies, and assess blood flow without the use of radiation.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-lung dep_icon"></span>
              <h2>Pulmonary Function Test (PFT)</h2>
              <p>
                Breathing assessments that measure lung capacity and airflow to
                help diagnose and manage respiratory conditions like asthma or
                COPD.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-time dep_icon"></span>
              <h2>Day Care Services</h2>
              <p>
                Medical treatments and minor procedures performed within the
                day, eliminating the need for overnight hospitalization.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-drug dep_icon"></span>
              <h2>IV Infusion Therapy</h2>
              <p>
                Direct administration of fluids or medications into the
                bloodstream for quicker recovery and improved treatment
                effectiveness.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-test dep_icon"></span>
              <h2>Vaccinations</h2>
              <p>
                Protective immunizations that guard against harmful diseases and
                strengthen long-term immunity for all age groups.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-automation dep_icon"></span>
              <h2>Drugless Therapies</h2>
              <p>
                Natural, non-pharmaceutical healing methods such as yoga,
                physiotherapy, and lifestyle modifications to support holistic
                well-being.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-physiotherapy dep_icon"></span>
              <h2>Physiotherapy</h2>
              <p>
                Therapeutic movement and exercise techniques that aid in
                recovery, reduce pain, and improve strength and mobility.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-stomach dep_icon"></span>
              <h2>Diet & Nutrition</h2>
              <p>
                Customized diet planning that supports overall health, disease
                management, and recovery through balanced and mindful eating.
              </p>
            </div>
            <div class="department_icon_content">
              <span class="flaticon-doctor-2 dep_icon"></span>
              <h2>Home Care Services</h2>
              <p>
                Home Care Services offer medical treatments and minor procedures
                at home, delivering professional care without the need for
                hospital visits.Bring expert medical care to the comfort of your
                home.
              </p>
            </div>
            <div class="department_icon_content">
  <img 
    src="/sleepingbed.png"
    alt="Sleep Study Icon"
    class="dep_icon sleep-icon"
  />
  <h2>Sleep Study</h2>
  <p>
    A specialized overnight diagnostic test that monitors sleep patterns,
    breathing, oxygen levels, heart activity, and body movements to
    diagnose sleep disorders such as sleep apnea and insomnia.
  </p>
</div>



          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="best-doctors hme-one">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="heading">
            <h1>HEALING HANDS, <span> CARING HEARTS</span></h1>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-lg-12">
          <div class="owl-carousel owl-theme three-item">
            <div class="best-doctor-outer">
              <div class="image">
                <img
                  src="https://res.cloudinary.com/dux0kv81i/image/upload/q_auto/f_auto/v1781610890/kdxthpmaymxnll1ykqb5.png"
                  class="img-fluid"
                  alt="best-doctors"
                />
                <a href="#" class="link"></a>
              </div>
              <div class="content-inner">
                <h2>Dr. Saurabh Jain</h2>
                <span
                  >Consultant Physician | MBBS, DNB (Medicine), PG Diabetology
                  (Boston), PGD Endocrinology (RCP, UK)</span
                >
                <p>
                  With over 15 years of experience, Dr. Saurabh Jain specializes
                  in internal medicine, diabetes, hypertension, and cardiac
                  care. He consults at Naivaidya Healthcare and is affiliated
                  with Sir HN Reliance Foundation, Jaslok, and Cumballa Hill
                  Hospital.
                  <br />A former physician with the Indian Air Force and
                  Railways, he holds advanced certifications from Boston
                  University and RCP, UK. He is an active member of IMA, API,
                  ASE, and the Jain Doctors Association, and regularly
                  contributes to medical conferences and research.
                </p>
              </div>
            </div>
            <div class="best-doctor-outer">
              <div class="image">
                <img
                  src="https://res.cloudinary.com/dux0kv81i/image/upload/q_auto/f_auto/v1781610890/siovw0mxvejnszjhvuzm.png"
                  class="img-fluid"
                  alt="best-doctors"
                />
                <a href="#" class="link"></a>
              </div>
              <div class="content-inner">
                <h2>Dr. Zimpu Mehta Jain</h2>
                <span
                  >Consulting Obstetrician & Gynaecologist Laparoscopic Surgeon
                  and Infertility Specialist MBBS ,DGO, FCPS, DNB</span
                >
                <p>
                  Dr Zimpu is a Compassionate gynecologist with 15 + years of
                  experience in providing comprehensive women's health services,
                  specializing in minimally invasive gynecological surgeries and
                  high-risk pregnancies. She also specialises in other
                  women&apos;s health issues, such as menopause, hormone
                  problems, contraception (birth control), and infertility and
                  also adolescent gynecological issues. She is affiliated with
                  Breach Candy Hospital, Asian Cancer Institute and Cumballa
                  Hill Hospital, St Elizabeth Hospital and Ruxmani Hospital. She
                  has proven ability to build strong patient relationships and
                  deliver positive health outcomes.
                  <br />
                  <br /> She has completed her MBBS from K.J. Somaiya Medical College,
                  followed by her Post graduate studies from Seth G.S. Medical College
                  & K.E.M. Hospital, Mumbai. She has undergone specialized laparoscopic
                  training under Dr. Hafeez Rehman at Sunrise Hospital, Kochi, and
                  has worked in the Department of Oncology- Gynaecology at Tata Memorial
                  Hospital. Dr. Jain is a life member of FOGSI, IAGE, and the Jain
                  Doctors Federation and has received many awards and recognition
                  for her outstanding performance and contribution to the field.
                </p>
              </div>
            </div>
            <div class="best-doctor-outer">
              <div class="image">
                <img
                  src="https://res.cloudinary.com/dux0kv81i/image/upload/q_auto/f_auto/v1781610890/mqtrxvyycmhqoqng8167.png"
                  class="img-fluid"
                  alt="best-doctors"
                />
                <a href="#" class="link"></a>
              </div>
              <div class="content-inner">
                <h2>Dr. Jignesh Mepani</h2>
                <span
                  >Bachelor of Physiotherapy | <br /> Certified Mulligan <br /> Practitioner
                </span>
                <p>
                  With over 18 years of experience, Dr. Jignesh Mepani specializes in helping 
                  individuals restore movement, manage pain, and regain function. As a Certified Mulligan 
                  Practitioner, he is trained in gentle, pain-free manual therapy techniques that ensure 
                  effective and comfortable recovery.
                  <br />During his 8-year tenure at Breach Candy Hospital, he worked across ICUs, 
                  wards, and OPDs, which shaped his patient-focused and result-driven approach. Dr. Mepani 
                  is dedicated to providing precise, personalized care that helps you move better, heal faster, 
                  and live pain-free.
                </p>
              </div>
            </div>
            <div class="best-doctor-outer">
              <div class="image">
                <img
                  src="https://res.cloudinary.com/dux0kv81i/image/upload/q_auto/f_auto/v1781614762/ply8h6l8lbbwqzlv5k5y.png"
                  class="img-fluid"
                  alt="best-doctors"
                />
                <a href="#" class="link"></a>
              </div>
              <div class="content-inner">
                <h2>Dr. Pulkit Popat</h2>
                <span
                  >Occupational Therapist | Neuro & Musculoskeletal
                  Rehabilitation <br /> Specialist</span
                >
                <p>
                  Dr. Pulkit Popat is a licensed Occupational Therapist with a degree 
                  from Seth G.S. Medical College & KEM Hospital, Mumbai, and over four years 
                  of experience in neuro and musculoskeletal rehabilitation. He specializes in stroke recovery, 
                  spinal cord injuries, orthopedic conditions, and chronic pain management.
                  <br />With his patient-centered and evidence-based approach, Dr. Popat designs 
                  personalized rehabilitation programs that help you restore independence, improve function, 
                  and enhance your quality of life.
                </p>
              </div>
            </div>

            <div class="best-doctor-outer">
              <div class="image">
                <img
                  src="https://res.cloudinary.com/dux0kv81i/image/upload/q_auto/f_auto/v1781614762/kib78zrehtoebew5qsji.png"
                  class="img-fluid"
                  alt="best-doctors"
                />
                <a href="#" class="link"></a>
              </div>
              <div class="content-inner">
                <h2>Ms. Amita Mishra</h2>
                <span
                  >MSc. Food Science & Nutrition | Yoga Instructor | Sports Nutritionist |  Diabetic Educator | Psychology Counsellor </span
                >
                <p>
                  Amita Mishra is a Holistic Nutritionist and Lifestyle Expert who works with individuals across age groups using a root-cause, counselling-led approach focused on long-term health. With a Master&apos;s degree in Food Science and Nutrition and training in psychology, sports nutrition, and exercise science, she integrates nutrition, movement, behaviour, and mental well-being to support sustainable outcomes.<br>
                  <br>Her work goes beyond meal plans, combining structured food planning, exercise guidance, behavioural change, and lifestyle modification through personalised coaching. She specialises in weight management, metabolic and digestive health, preventive care, and women&apos;s hormonal health, helping individuals build healthier habits and achieve measurable, lasting improvements.</br>
                </p>
              </div>
            </div>

            <div class="best-doctor-outer">
              <div class="image">
                <img
                  src="https://res.cloudinary.com/dux0kv81i/image/upload/q_auto/f_auto/v1781614762/z2nklare8g5mfg0bueja.jpg"
                  class="img-fluid"
                  alt="best-doctors"
                />
                <a href="#" class="link"></a>
              </div>
              <div class="content-inner">
                <h2>Ms. Harshita Saraogi</h2>
                <span
                  >Healing arts therapist and wellness specialist <br />
                  <br /></span
                >
                <p>
                  A certified Craniosacral Therapy practitioner and Ayurvedic
                  consultant with over 13 years of experience in the fields of
                  psychotherapy, Pranic Healing, and Arhatic Yoga. Currently
                  serving as a dedicated mental health coach for students, I
                  specialize in integrating holistic and energy-based healing
                  methods to support emotional balance, mental clarity, and
                  overall well-being. My approach combines ancient wisdom with
                  modern therapeutic practices to help individuals navigate
                  stress, trauma, and life transitions more mindfully and
                  effectively.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

