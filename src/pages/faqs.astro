---
import Layout from "../layouts/Layout.astro";
import { faqs } from "../constants/faqs";
---

<Layout>
  <div class="faq_s" style="padding-top: 20px; padding-bottom: 50px;">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="heading">
            <h1>FAQ's</h1>
          </div>
          <div class="accordion" id="faq-accordion">
            {
              faqs.map((faq, index) => (
                <div class="card">
                  <div class="card-header" id={`heading${index}`}>
                    <h5 class="mb-0">
                      <button
                        class="btn-block text-left btn btn-link collapsed"
                        type="button"
                        data-toggle="collapse"
                        data-target={`#collapse${index}`}
                        aria-expanded="false"
                        aria-controls={`collapse${index}`}
                      >
                        {faq.question} <i class="flaticon-plus main n-active" />
                        <i class="flaticon-minus main active-min" />
                      </button>
                    </h5>
                  </div>
                  <div
                    id={`collapse${index}`}
                    class="collapse fade"
                    aria-labelledby={`heading${index}`}
                    data-parent="#faq-accordion"
                  >
                    <div class="card-body">{faq.answer}</div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
